NODE_ENV=development
PORT=3000

# postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/bed_stack

# Better-auth — min 32 chars
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Redis
REDIS_URL=redis://localhost:6379

# CORS — comma-separated origins (production only)
ALLOWED_ORIGINS=http://localhost:5173

# AWS S3 (optional — needed only if using file uploads)
# AWS_REGION=eu-central-1
# S3_BUCKET=your-bucket-name

# Stripe (optional)
# STRIPE_SECRET_KEY=sk_test_...

# Meilisearch (optional)
# MEILISEARCH_URL=http://localhost:7700
# MEILISEARCH_API_KEY=your-master-key

# Social login (optional — uncomment providers you need)
# Google: console.cloud.google.com → APIs & Services → Credentials
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...

# GitHub: github.com/settings/developers → OAuth Apps
# GITHUB_CLIENT_ID=...
# GITHUB_CLIENT_SECRET=...
